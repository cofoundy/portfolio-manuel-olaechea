---
/**
 * CONTACTO — Dark footer with quote + contact links
 * Combines footer + CTA into one warm, simple section.
 */
import { siteConfig } from "../config";
---

<footer id="contacto" class="py-16 md:py-24" style="background-color: var(--earth-dark)">
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">

    <!-- Quote -->
    <div class="reveal mb-10 max-w-2xl mx-auto">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="36"
        height="36"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--earth-light)"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mx-auto mb-4 opacity-40"
      >
        <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/>
        <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 .001 0 .001 0 0z"/>
      </svg>
      <p
        class="text-lg md:text-xl leading-relaxed italic"
        style="color: rgba(247, 242, 234, 0.85); font-family: 'Libre Baskerville', serif"
      >
        {siteConfig.quote}
      </p>
      <p class="mt-4 text-sm" style="color: var(--earth-light)">
        &mdash; {siteConfig.shortName}
      </p>
    </div>

    <!-- Divider -->
    <div
      class="w-12 h-px mx-auto mb-10"
      style="background-color: var(--earth-light)"
    ></div>

    <!-- Contact buttons -->
    <div class="reveal stagger-1 flex flex-wrap items-center justify-center gap-4 mb-10">
      <a
        href={`mailto:${siteConfig.social.email}`}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg text-white font-medium text-sm md:text-base"
        style="background-color: var(--green)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span class="hidden sm:inline">{siteConfig.social.email}</span>
        <span class="sm:hidden">Email</span>
      </a>
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium"
        style="border: 1.5px solid var(--earth-light); color: var(--sand)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        LinkedIn
      </a>
    </div>

    <!-- Copyright -->
    <p class="text-xs" style="color: rgba(160, 128, 96, 0.5)">
      &copy; 2026 {siteConfig.shortName}
    </p>
  </div>
</footer>
