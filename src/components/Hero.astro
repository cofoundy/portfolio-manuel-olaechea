---
import { siteConfig } from "../config";
const lines = siteConfig.name.split("\n");
---

<section id="hero" class="py-16 md:py-24" style="background-color: var(--sand)">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-14">

      <!-- Photo -->
      <div class="anim-photo flex-shrink-0 mx-auto md:mx-0">
        <div
          class="w-48 h-48 md:w-56 md:h-56 rounded-2xl overflow-hidden"
          style="border: 3px solid var(--earth-light); box-shadow: 0 12px 32px -8px rgba(42, 31, 20, 0.2)"
        >
          <img
            src={`${import.meta.env.BASE_URL}/profile.jpg`}
            alt={siteConfig.shortName}
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Text -->
      <div class="text-center md:text-left">
        <h1 class="anim-name text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight" style="color: var(--earth-dark)">
          {lines.map((line, i) => (
            <span class:list={[i > 0 && "block"]}>{line}</span>
          ))}
        </h1>

        <div class="anim-title mt-4 flex flex-wrap items-center justify-center md:justify-start gap-2">
          <p class="text-base md:text-xl" style="color: var(--earth); font-family: 'Source Sans 3', sans-serif">
            {siteConfig.title}
          </p>
          <span
            class="inline-flex items-center gap-1 text-sm px-3 py-1 rounded-full"
            style="background-color: var(--earth-dark); color: var(--sand)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {siteConfig.location}
          </span>
        </div>

        <p
          class="anim-tagline mt-5 text-base sm:text-lg md:text-2xl italic"
          style="color: var(--green); font-family: 'Libre Baskerville', serif"
        >
          "{siteConfig.tagline}"
        </p>

        <!-- CTA buttons -->
        <div class="anim-cta mt-6 flex flex-wrap items-center justify-center md:justify-start gap-3">
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-white font-medium text-sm"
            style="background-color: var(--green)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Contactar
          </a>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-sm"
            style="border: 1.5px solid var(--earth-light); color: var(--earth)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="anim-stats mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
      {siteConfig.stats.map((stat) => (
        <div
          class="text-center py-4 px-3 rounded-xl"
          style="background-color: var(--sand-light); border: 1px solid rgba(160, 128, 96, 0.2)"
        >
          <div class="text-2xl md:text-3xl font-bold" style="color: var(--green); font-family: 'Libre Baskerville', serif">
            {stat.value}
          </div>
          <div class="text-sm mt-1" style="color: var(--earth-light)">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
