---
/**
 * TRAYECTORIA — Vertical timeline with dots
 * Clean, professional career timeline.
 */
import { siteConfig } from "../config";
---

<section id="trayectoria" class="py-16 md:py-24" style="background-color: var(--sand)">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="reveal-left mb-12">
      <h2
        class="text-3xl md:text-4xl font-bold"
        style="color: var(--earth-dark)"
      >
        Trayectoria
      </h2>
      <div class="w-16 h-1 mt-3 rounded-full" style="background-color: var(--green)"></div>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div
        class="absolute top-0 bottom-0 left-4 md:left-6 w-px"
        style="background-color: var(--earth-light)"
      ></div>

      <div class="space-y-10">
        {siteConfig.trayectoria.map((entry, i) => (
          <div class={`reveal stagger-${i + 1} relative pl-12 md:pl-16`}>
            <!-- Dot -->
            <div
              class="absolute left-2 md:left-4 top-1 w-5 h-5 rounded-full z-10"
              style={`background-color: ${i === 0 ? 'var(--green)' : 'var(--earth-light)'}; border: 3px solid var(--sand)`}
            ></div>

            <!-- Period badge -->
            <span
              class="inline-block text-xs px-3 py-1 rounded-full mb-2"
              style="background-color: rgba(160, 128, 96, 0.12); color: var(--earth-light)"
            >
              {entry.periodo}
            </span>

            <!-- Role -->
            <h3
              class="text-lg md:text-xl font-bold"
              style="color: var(--earth-dark)"
            >
              {entry.cargo}
            </h3>
            <p class="text-base" style="color: var(--green)">
              {entry.empresa}
            </p>

            <!-- Achievements -->
            <ul class="mt-3 space-y-1.5">
              {entry.logros.map((logro) => (
                <li class="flex items-start text-sm" style="color: var(--earth)">
                  <span
                    class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-2.5 flex-shrink-0"
                    style="background-color: var(--earth-light)"
                  ></span>
                  {logro}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
