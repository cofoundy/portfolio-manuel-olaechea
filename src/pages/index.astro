---
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Legado from "../components/Legado.astro";
import Impacto from "../components/Impacto.astro";
import Proyectos from "../components/Proyectos.astro";
import Trayectoria from "../components/Trayectoria.astro";
import Contacto from "../components/Contacto.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.shortName} — {siteConfig.title}</title>
  </head>
  <body>
    <Nav />
    <main class="pt-12">
      <Hero />
      <Legado />
      <Impacto />
      <Proyectos />
      <Trayectoria />
    </main>
    <Contacto />

    <!-- Scroll Reveal -->
    <script>
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
      );

      document.querySelectorAll('.reveal, .reveal-left, .impact-card').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
